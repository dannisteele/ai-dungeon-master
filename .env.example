TABLE_PASSWORD=change-me
PORT=3000
HOST=0.0.0.0
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.6:27b
OLLAMA_KEEP_ALIVE=30m
DB_PATH=./data/game.sqlite
# How much the DM can hold in mind at once. Lower (e.g. 8192) is faster on graphics cards
# with little memory; `npm run bench` measures it. The prompt budget follows unless set.
OLLAMA_NUM_CTX=16384
# Optional: lets players send bug reports and ideas as GitHub issues (see README)
GITHUB_TOKEN=
GITHUB_REPO=dannisteele/ai-dungeon-master
